{
  "name": "money-books",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tools/katex.test.mjs && python3 tools/check.py && node tools/factcheck.cjs",
    "catalog": "python3 tools/sync-catalog.py",
    "sitemap": "python3 tools/sync-sitemap.py",
    "import:check": "python3 tools/import-books.py --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "katex": "0.16.9",
    "@euiyun/book": "https://codeload.github.com/geniuskey/book/tar.gz/refs/tags/v0.1.3"
  }
}
